<?xml version="1.0" encoding="utf-8"?>
<!-- The app is dark in light and dark mode alike, so there is one set of
     themes and no values-night: a light theme here is what used to flash a
     white launch screen before the Flutter splash. Android 12+ overrides
     LaunchTheme in values-v31. -->
<resources>
    <!-- Applied while the process starts; removed when the Flutter engine
         draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once the process has started: the color behind the Flutter
         view while it initialises and while it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_ground</item>
    </style>
</resources>
