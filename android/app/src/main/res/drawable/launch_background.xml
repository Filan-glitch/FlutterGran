<?xml version="1.0" encoding="utf-8"?>
<!-- What Android shows before Flutter's first frame, up to Android 11
     (Android 12+ shows its own splash, values-v31/styles.xml). The app's
     ground with the launcher icon's tally on it, so launching goes dark
     straight into the Flutter splash rather than flashing white first. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_ground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
