<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replaces launch_background with the system splash: the
     launcher icon on a solid color. Give it the app's ground in light and
     dark mode alike, so there is no white frame before the Flutter splash. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_ground</item>
    </style>
</resources>
